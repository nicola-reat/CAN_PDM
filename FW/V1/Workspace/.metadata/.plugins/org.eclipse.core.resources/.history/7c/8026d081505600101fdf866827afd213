#ifndef INC_PCAL6524_H_
#define INC_PCAL6524_H_

#include "stm32f4xx_hal.h"
#include "i2c.h"

/**
 * @brief Struct representing a PCAL6524 I/O expander device.
 *
 * This structure holds the configuration needed to communicate
 * with a PCAL6524 device over the I2C bus.
 *
 * - hi2c: Pointer to the STM32 HAL I2C handle used for communication.
 * - i2c_addr: 8-bit I2C address of the device (left-shifted by 1).
 */
typedef struct {
    I2C_HandleTypeDef *hi2c;
    uint8_t i2c_addr;
} PCAL6524;

// Configuration Registers

// Input Port Registers (Read only)
#define PCAL6524_REG_INPUT_PORT0         0x00
#define PCAL6524_REG_INPUT_PORT1         0x01
#define PCAL6524_REG_INPUT_PORT2         0x02

// Output Port Registers (Read/Write)
#define PCAL6524_REG_OUTPUT_PORT0        0x04
#define PCAL6524_REG_OUTPUT_PORT1        0x05
#define PCAL6524_REG_OUTPUT_PORT2        0x06

// Polarity Inversion Registers (Read/Write)
#define PCAL6524_REG_POLARITY_PORT0      0x08
#define PCAL6524_REG_POLARITY_PORT1      0x09
#define PCAL6524_REG_POLARITY_PORT2      0x0A

// Configuration Registers (1 = input, 0 = output) (Read/Write)
#define PCAL6524_REG_CONFIG_PORT0        0x0C
#define PCAL6524_REG_CONFIG_PORT1        0x0D
#define PCAL6524_REG_CONFIG_PORT2        0x0E

// Output Drive Strength Registers (Optional) (Read/Write)
#define PCAL6524_REG_OUTPUT_DRIVE0_PORT0 0x40
#define PCAL6524_REG_OUTPUT_DRIVE1_PORT0 0x41
#define PCAL6524_REG_OUTPUT_DRIVE0_PORT1 0x42
#define PCAL6524_REG_OUTPUT_DRIVE1_PORT1 0x43
#define PCAL6524_REG_OUTPUT_DRIVE0_PORT2 0x44
#define PCAL6524_REG_OUTPUT_DRIVE1_PORT2 0x45

// Input Latch Registers (Read/Write)
#define PCAL6524_REG_INPUT_LATCH_PORT0   0x48
#define PCAL6524_REG_INPUT_LATCH_PORT1   0x49
#define PCAL6524_REG_INPUT_LATCH_PORT2   0x4A

// Pull-Up/Pull-Down Enable Registers (Read/Write)
#define PCAL6524_REG_PULL_EN_PORT0       0x4C
#define PCAL6524_REG_PULL_EN_PORT1       0x4D
#define PCAL6524_REG_PULL_EN_PORT2       0x4E

// Pull-Up/Pull-Down Selection Registers (0 = pull-down, 1 = pull-up)
#define PCAL6524_REG_PULL_SEL_PORT0      0x50
#define PCAL6524_REG_PULL_SEL_PORT1      0x51
#define PCAL6524_REG_PULL_SEL_PORT2      0x52

// Interrupt Mask Registers (1 = masked/disabled)
#define PCAL6524_REG_INT_MASK_PORT0      0x54
#define PCAL6524_REG_INT_MASK_PORT1      0x55
#define PCAL6524_REG_INT_MASK_PORT2      0x56

// Interrupt Status Registers (Read only)
#define PCAL6524_REG_INT_STATUS_PORT0    0x58
#define PCAL6524_REG_INT_STATUS_PORT1    0x59
#define PCAL6524_REG_INT_STATUS_PORT2    0x5A

// Output Port Configuration (Push-pull or Open-drain)
#define PCAL6524_REG_OUTPUT_PORT_CONFIG  0x5C

// Interrupt Edge Register (0 = level, 1 = edge)
#define PCAL6524_REG_INT_EDGE_PORT0      0x60
#define PCAL6524_REG_INT_EDGE_PORT1      0x61
#define PCAL6524_REG_INT_EDGE_PORT2      0x62

// Edge Sensing Registers (Falling/Rising)
#define PCAL6524_REG_INT_FALLING_PORT0   0x64
#define PCAL6524_REG_INT_FALLING_PORT1   0x65
#define PCAL6524_REG_INT_FALLING_PORT2   0x66

#define PCAL6524_REG_INT_RISING_PORT0    0x68
#define PCAL6524_REG_INT_RISING_PORT1    0x69
#define PCAL6524_REG_INT_RISING_PORT2    0x6A

// System Control Registers
#define PCAL6524_REG_RESET               0x6C
#define PCAL6524_REG_CLOCK               0x6D
#define PCAL6524_REG_MISC                0x6E

// Individual Pin Output Configuration Registers (Push-pull/Open-drain per pin)
#define PCAL6524_REG_INDIV_OUTCFG_PORT0  0x70
#define PCAL6524_REG_INDIV_OUTCFG_PORT1  0x71
#define PCAL6524_REG_INDIV_OUTCFG_PORT2  0x72

// Switch Debounce Enable Registers (Read/Write)
#define PCAL6524_REG_DEBOUNCE_ENABLE_PORT0   0x74
#define PCAL6524_REG_DEBOUNCE_ENABLE_PORT1   0x75
#define PCAL6524_REG_DEBOUNCE_ENABLE_PORT2   0x76

//Define Input or Output direction
#define INPUT  1
#define OUTPUT 0
/**
 * @brief  Set the direction of a specific pin on the PCAL6524 I/O expander.
 *
 * @param  expander  Pointer to the PCAL6524 device struct (contains I2C handle and address).
 * @param  port      Port number (0, 1, or 2) of the PCAL6524.
 * @param  pin       Pin number (0 to 7) within the selected port.
 * @param  is_output Set to 1 to configure the pin as output, 0 as input.
 *
 * @note   This function reads the current configuration register for the selected port,
 *         modifies only the bit corresponding to the pin direction, and writes back the updated value.
 *         A bit set to 1 configures the pin as input, 0 as output.
 */
void PCAL6524_SetPinDirection(PCAL6524 *expander, uint8_t port, uint8_t pin, uint8_t is_output); //Set Pin Input / Ouput
void PCAL6524_SetPortDirectionSimple(PCAL6524 *expander, uint8_t port, uint8_t direction); //Set Port Input / Output

#endif /* INC_PCAL6524_H_ */

#ifndef INC_SETTINGS_H_
#define INC_SETTINGS_H_

#define NUM_ADC_CHANNELS 12 //Define adc Channels
uint16_t Adc_Dma_Bfr[NUM_ADC_CHANNELS]; //Buffer to store adc value

// Status for Board
typedef enum {
    BOARD_OK = 0, //Everythings is ok
    BOARD_KO_CAN, //Error on CAN init
    BOARD_KO_ADC, //Error on ADC init
	BOARD_KO_I2C, //Error on I2C Init
    BOARD_KO_TEMP, //Error on Temp init

} BoardStatus_t;

//Set Board Status
void Board_SetStatus(BoardStatus_t status);
//Get Board Status
BoardStatus_t Board_GetStatus(void);

#endif /* INC_SETTINGS_H_ */

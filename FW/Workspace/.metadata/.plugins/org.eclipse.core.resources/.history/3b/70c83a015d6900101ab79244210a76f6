//Profet Set state
void Profet_SetState(ProfetChannel_t *channel, bool enable)
{
    channel->isEnabled = enable;

    if (enable)
    {
        //Set gpio to high. Profet is on
        HAL_GPIO_WritePin(channel->gpio_port, channel->gpio_pin, GPIO_PIN_SET);
    }
    else
    {
        //Set gpio to low. Profet is off
        HAL_GPIO_WritePin(channel->gpio_port, channel->gpio_pin, GPIO_PIN_RESET);
    }
}

//Profet update all current
//ADC Read channel raw:
	/*
	 * 0 --> ADC_CH7 MCU_IS_H1
	 * 1 --> ADC_CH6 MCU_IS_H2
	 * 2 --> ADC_CH5 MCU_IS_H3
	 * 3 --> ADC_CH4 MCU_IS_M1
	 * 4 --> ADC_CH2 MCU_IS_M2
	 * 5 --> ADC_CH0 MCU_IS_L1_2
	 * 6 --> ADC_CH1 MCU_IS_L3_4
	 * 7 --> ADC_CH10 MCU_SENS1
	 * 8 --> ADC_CH11 MCU_SENS2
	 * 9 --> ADC_CH12 MCU_SENS3
	 * 10 -->ADC_CH13 MCU_SENS4
	 * 11 -->ADC_CH3 MCU_BATT_REF
	 */
void Profet_UpdateAllCurrents(void)
{
	// Convert raw ADC reading to current in mA using ADC resolution, reference voltage, KILIS (current gain), and sense resistor value
    profet_Hout1.current_mA = ((float)ADC_ReadChannelRaw(0)) * 3.3f / 4095.0f * profet_Hout1.kilis / profet_Hout1.rSense;
    profet_Hout2.current_mA = ((float)ADC_ReadChannelRaw(1)) * 3.3f / 4095.0f * profet_Hout2.kilis / profet_Hout2.rSense;
    profet_Hout3.current_mA = ((float)ADC_ReadChannelRaw(2)) * 3.3f / 4095.0f * profet_Hout3.kilis / profet_Hout3.rSense;
    profet_Mout1.current_mA = ((float)ADC_ReadChannelRaw(3)) * 3.3f / 4095.0f * profet_Mout1.kilis / profet_Mout1.rSense;
    profet_Mout2.current_mA = ((float)ADC_ReadChannelRaw(4)) * 3.3f / 4095.0f * profet_Mout2.kilis / profet_Mout2.rSense;
    profet_Lout1.current_mA = ((float)ADC_ReadChannelRaw(5)) * 3.3f / 4095.0f * profet_Lout1.kilis / profet_Lout1.rSense;
    profet_Lout2.current_mA = ((float)ADC_ReadChannelRaw(5)) * 3.3f / 4095.0f * profet_Lout2.kilis / profet_Lout2.rSense;
    profet_Lout3.current_mA = ((float)ADC_ReadChannelRaw(6)) * 3.3f / 4095.0f * profet_Lout3.kilis / profet_Lout3.rSense;
    profet_Lout4.current_mA = ((float)ADC_ReadChannelRaw(6)) * 3.3f / 4095.0f * profet_Lout4.kilis / profet_Lout4.rSense;
}


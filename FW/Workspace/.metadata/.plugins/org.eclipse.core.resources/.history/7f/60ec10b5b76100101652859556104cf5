#include "settings.h"

static BoardStatus_t boardStatus = BOARD_OK; //Init Board with OK status

//Function to set board Status
void Board_SetStatus(BoardStatus_t status) {
    boardStatus = status;
}

//Function to get board Status
BoardStatus_t Board_GetStatus(void) {
    return boardStatus;
}

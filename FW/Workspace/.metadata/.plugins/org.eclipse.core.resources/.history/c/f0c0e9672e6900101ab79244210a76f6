//Profet update all current
//ADC Read channel raw:
	/*
	 * 0 -- >
	 *
	 *
	 */
void Profet_UpdateAllCurrents(void)
{
    profet_Hout1.current_mA = ((float)ADC_ReadChannelRaw(0)) * 3.3f / 4095.0f * profet_Hout1.kilis / profet_Hout1.rSense;
    profet_Hout2.current_mA = ((float)ADC_ReadChannelRaw(1)) * 3.3f / 4095.0f * profet_Hout2.kilis / profet_Hout2.rSense;
    profet_Hout3.current_mA = ((float)ADC_ReadChannelRaw(2)) * 3.3f / 4095.0f * profet_Hout3.kilis / profet_Hout3.rSense;
    profet_Mout1.current_mA = ((float)ADC_ReadChannelRaw(2)) * 3.3f / 4095.0f * profet_Mout1.kilis / profet_Mout1.rSense;
    profet_Mout2.current_mA = ((float)ADC_ReadChannelRaw(2)) * 3.3f / 4095.0f * profet_Mout2.kilis / profet_Mout2.rSense;
    profet_Lout1.current_mA = ((float)ADC_ReadChannelRaw(2)) * 3.3f / 4095.0f * profet_Lout1.kilis / profet_Lout1.rSense;
    profet_Lout2.current_mA = ((float)ADC_ReadChannelRaw(2)) * 3.3f / 4095.0f * profet_Lout2.kilis / profet_Lout2.rSense;
    profet_Lout3.current_mA = ((float)ADC_ReadChannelRaw(2)) * 3.3f / 4095.0f * profet_Lout3.kilis / profet_Lout3.rSense;
    profet_Lout4.current_mA = ((float)ADC_ReadChannelRaw(2)) * 3.3f / 4095.0f * profet_Lout4.kilis / profet_Lout4.rSense;

}
